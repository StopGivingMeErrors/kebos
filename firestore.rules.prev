rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /schedules/{slotId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
  }
}
