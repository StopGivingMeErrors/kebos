# --- Resend (Vercel env) ---
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Kevos <bookings@kevos.site>
# EMAIL_REPLY_TO=hello@kevos.site

# --- Firebase Admin SDK (Vercel env — NEVER commit the real private key) ---
# From Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=kebos-d63af
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@kebos-d63af.iam.gserviceaccount.com
# Paste the private_key value; keep \n escapes when setting in Vercel
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Optional Upstash Redis (rate limits). RECOMMENDED in production. ---
# Without these, Firestore _rateLimits fixed-window fallback is used (set a TTL policy on expireAt).
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxx...

# --- Optional CORS allowlist (comma-separated). Defaults include kevos.site + www. ---
# ALLOWED_ORIGINS=https://kevos.site,https://www.kevos.site,https://kebos.vercel.app
