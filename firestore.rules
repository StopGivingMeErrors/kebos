rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Guests may read free/booked slots for the booking UI.
    // All writes (including isBooked) are staff-only or Admin SDK (server).
    match /schedules/{slotId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Guests cannot create, get, list, update, or delete bookings from the client.
    // Book/cancel go through /api/book and /api/cancel (Admin SDK).
    // Staff (signed-in) can list/read/manage for the dashboard.
    match /bookings/{bookingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
  }
}
