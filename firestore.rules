rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Barber only — custom claim staff:true (set via scripts/set-staff-claim.js).
    // Any other signed-in user (including if Auth sign-up is open) is denied.
    function isStaff() {
      return request.auth != null && request.auth.token.staff == true;
    }

    // Guests may read slots for the booking UI.
    // Writes (create/update/delete) are staff-only. Booking flips isBooked via Admin SDK.
    match /schedules/{slotId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    // Guests never touch bookings from the client (book/cancel via /api/*).
    // Staff may read/list for the dashboard. No client writes to bookings at all.
    match /bookings/{bookingId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    // Rate-limit windows written only by Admin SDK (server). Deny all client access.
    match /_rateLimits/{docId} {
      allow read, write: if false;
    }
  }
}
