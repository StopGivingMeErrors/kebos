{
  "name": "kebos",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "firebase": "^12.3.0",
    "firebase-admin": "12.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "react-scripts": "5.0.1",
    "recharts": "^3.7.0",
    "resend": "^6.9.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "test:rules": "firebase emulators:exec --only firestore --project kebos-rules-test \"node tests/firestore.rules.test.js\"",
    "test:book-concurrency": "firebase emulators:exec --only firestore --project kebos-concurrency-test \"node tests/book.concurrency.test.js\"",
    "test:book-concurrency:unit": "node tests/book.concurrency.unit.test.js",
    "lint": "eslint \"src/**/*.{js,jsx}\" \"api/**/*.js\" \"tests/**/*.js\" --max-warnings 0",
    "test:stats": "node tests/statsLogic.test.js",
    "test:stats-cache": "node tests/statsCache.test.js",
    "test:cors": "node tests/cors.test.js",
    "test:client-ip": "node tests/clientIp.test.js",
    "test:admin-config": "node tests/firebaseAdminConfig.test.js",
    "test:ratelimit": "firebase emulators:exec --only firestore --project kebos-ratelimit-test \"node tests/rateLimit.test.js\"",
    "test:upstash-env": "node tests/upstashEnv.test.js",
    "test:security": "npm run test:rules && npm run test:book-concurrency && npm run test:stats && npm run test:stats-cache && npm run test:cors && npm run test:client-ip && npm run test:admin-config && npm run test:upstash-env && npm run test:ratelimit",
    "audit:consistency": "node scripts/audit-consistency.js",
    "staff:claim": "node scripts/set-staff-claim.js",
    "staff:check": "node scripts/check-staff-claim.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "engines": {
    "node": "22.x"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "dotenv": "^18.0.10",
    "firebase-tools": "^15.36.0"
  }
}
